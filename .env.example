# homemath configuration. Copy to .env and edit. No value here is real.

# Base URL of the OpenAI-compatible endpoint. Must expose /v1/chat/completions.
LLM_HOST=http://127.0.0.1:8080

# Optional second endpoint, tried after LLM_HOST. Defaults to LLM_HOST.
LLM_HOST_FALLBACK=

# Bearer token for the endpoint. Leave empty if the endpoint needs no auth.
LLM_API_KEY=

# Model id sent in the request body for each endpoint.
LLM_MODEL_PRIMARY=local-model
LLM_MODEL_FALLBACK=

# Per-request timeouts in seconds.
LLM_TIMEOUT_PRIMARY=600
LLM_TIMEOUT_FALLBACK=60

# Timeout in seconds for the /v1/models availability probe.
LLM_MODEL_PROBE_TIMEOUT=5

# Set to "true" to skip the startup model probe and trust the configuration.
LLM_READY=false

# Optional Redis URL for a shared response cache. Unset means in-memory only.
REDIS_URL=

# Prompt token budget before trimming, and the per-system-message cap.
HOMEMATH_TOKEN_BUDGET=28000
HOMEMATH_SYSTEM_HARD_CAP=6000

# Optional regex alternation naming your subject area, enabling TaskClass.DOMAIN.
# Example: HOMEMATH_DOMAIN_KEYWORDS=ledger|invoice|reconciliation
HOMEMATH_DOMAIN_KEYWORDS=
